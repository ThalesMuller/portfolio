    "@playwright/test": "1.65.1",
    "@types/node": "^24.0.0",
    "@types/pdfkit": "0.17.7",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitest/coverage-v8": "5.1.0",
    "eslint": "10.15.0",
    "lucide-react": "0.577.0",
    "pdfjs-dist": "5.6.205",
    "pdfkit": "0.20.2",
    "prettier": "3.10.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "tsx": "4.23.15",
